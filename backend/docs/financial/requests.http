@baseUrl = http://localhost:3000

@contentType = application/json

@accessToken = {{login.response.body.$.accessToken}}

@projectId = f1bc6e40-154c-43ba-8018-55bda3ba95f0

@financialId = 27a3af12-31bf-4a9e-be88-d9ea05282b2e


### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
    "email": "john123123@example.com",
    "password": "Password123!"
}

### Create financial
# @name createFinancial
POST {{baseUrl}}/financial/
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
    "type": "expense",
    "description": "Expense for office supplies",
    "value": 100,
    "status": "paid",
    "date": "2023-01-01",
    "projectId": "f1bc6e40-154c-43ba-8018-55bda3ba95f0"
}

### Get all financial
GET {{baseUrl}}/financial
Authorization: Bearer {{accessToken}}

### Get Project Balance by project id
GET {{baseUrl}}/financial/project/{{projectId}}/balance
Authorization: Bearer {{accessToken}}

### Get financial by id
GET {{baseUrl}}/financial/{{financialId}}
Authorization: Bearer {{accessToken}}

### Get financial by project id
GET {{baseUrl}}/financial/project/{{projectId}}
Authorization: Bearer {{accessToken}}

### Update Financial by id
PATCH {{baseUrl}}/financial/{{financialId}}
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
    "value": 1000
}

### Delete Financial by id
DELETE {{baseUrl}}/financial/{{financialId}}
Authorization: Bearer {{accessToken}}