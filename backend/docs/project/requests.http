@baseUrl = http://localhost:3000

@contentType = application/json

@accessToken = {{login.response.body.$.accessToken}}

@projectId = {{createProject.response.body.$.id}}

@clientId = a6f1bfb1-3401-4199-bdf1-e9201116ea52

@packageId = 96b86379-7b30-4ae8-804a-1d6c71e120bf


### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
    "email": "john123123@example.com",
    "password": "Password123!"
}

### Create project
# @name createProject
POST {{baseUrl}}/projects/
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
    "title": "Testee33542633",
    "notes": "Testee",
    "location": "Testee",
    "startAt": "2023-01-03T15:00:00.000Z",
    "endAt": "2023-01-03T16:00:00.000Z",
    "clientId": "{{clientId}}",
    "packageId": "{{packageId}}"
}


### Get all projects
GET {{baseUrl}}/projects
Authorization: Bearer {{accessToken}}

### Get project by id
GET {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{accessToken}}

### Update Project by id
PATCH {{baseUrl}}/projects/{{projectId}}
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
    "notes": "teste",
    "agreed_price": 150
}


### Delete Project by id
DELETE {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{accessToken}}